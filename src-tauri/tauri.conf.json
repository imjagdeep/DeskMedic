{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskMedic",
  "version": "0.5.1",
  "identifier": "app.deskmedic.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "publisher": "Jagdeep Sandhu",
    "copyright": "Copyright (c) 2026 Jagdeep Sandhu. MIT License.",
    "category": "Utility",
    "shortDescription": "Helpdesk disk utility for Windows",
    "longDescription": "DeskMedic finds what fills a disk, clears temporary files safely, fixes common Disk Management problems and runs one-click fixes for helpdesk calls.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVCMzA1OTY3OUEyRUNCNzUKUldSMXl5NmFaMWt3Njl0UkViUHl4d1dGM2tXZktqYkpmMjdtSG45bU83bitNSWpNWW00MGpMcysK",
      "endpoints": [
        "https://github.com/imjagdeep/DeskMedic/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
